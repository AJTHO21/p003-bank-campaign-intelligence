	partition prior_failure_strata = m
		mode: import
		source =
				let
				    Parsed = Csv.Document(File.Contents(P003CsvFolder & "\prior_failure_strata.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Parsed, [PromoteAllScalars=true]),
				    Expected = {"source_sha256", "dimension", "stratum", "a_yes", "a_n", "b_yes", "b_n", "a_rate", "b_rate", "gap_pp", "sparse"},
				    Checked = if Table.ColumnNames(Headers) = Expected then Headers else error "Unexpected P003 CSV headers",
				    Nullable = {"a_rate", "b_rate", "gap_pp"},
				    Blanks = if List.IsEmpty(Nullable) then Checked else Table.ReplaceValue(Checked, "", null, Replacer.ReplaceValue, Nullable),
				    Typed = Table.TransformColumnTypes(Blanks, {{"source_sha256", type text}, {"dimension", type text}, {"stratum", type text}, {"a_yes", Int64.Type}, {"a_n", Int64.Type}, {"b_yes", Int64.Type}, {"b_n", Int64.Type}, {"a_rate", type number}, {"b_rate", type number}, {"gap_pp", type number}, {"sparse", type logical}}, "en-US"),
				    Verified = if Table.RowCount(Typed) = 16 then Typed else error "Unexpected P003 CSV row count"
				in
				    Verified

	annotation PBI_ResultType = Table
