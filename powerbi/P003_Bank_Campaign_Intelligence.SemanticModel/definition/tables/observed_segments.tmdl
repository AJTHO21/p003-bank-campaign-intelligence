	partition observed_segments = m
		mode: import
		source =
				let
				    Parsed = Csv.Document(File.Contents(P003CsvFolder & "\observed_segments.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Parsed, [PromoteAllScalars=true]),
				    Expected = {"source_sha256", "dimension", "level", "numerator", "denominator", "rate", "reference_pct", "gap_pp", "wilson_low_pct", "wilson_high_pct", "sparse"},
				    Checked = if Table.ColumnNames(Headers) = Expected then Headers else error "Unexpected P003 CSV headers",
				    Nullable = {"rate", "gap_pp", "wilson_low_pct", "wilson_high_pct"},
				    Blanks = if List.IsEmpty(Nullable) then Checked else Table.ReplaceValue(Checked, "", null, Replacer.ReplaceValue, Nullable),
				    Typed = Table.TransformColumnTypes(Blanks, {{"source_sha256", type text}, {"dimension", type text}, {"level", type text}, {"numerator", Int64.Type}, {"denominator", Int64.Type}, {"rate", type number}, {"reference_pct", type number}, {"gap_pp", type number}, {"wilson_low_pct", type number}, {"wilson_high_pct", type number}, {"sparse", type logical}}, "en-US"),
				    Verified = if Table.RowCount(Typed) = 48 then Typed else error "Unexpected P003 CSV row count"
				in
				    Verified

	annotation PBI_ResultType = Table
