table observed_segments
	lineageTag: 9902c3d0-6d8c-5bb0-b2a4-2ae9ca06147a

	measure 'observed_segments observed rate' = IF(HASONEVALUE(observed_segments[dimension]), DIVIDE(SUM(observed_segments[numerator]), SUM(observed_segments[denominator])))
		formatString: 0.00%
		lineageTag: e2eee6ca-8986-5b46-b3e5-f387cd91a7b0

	column source_sha256
