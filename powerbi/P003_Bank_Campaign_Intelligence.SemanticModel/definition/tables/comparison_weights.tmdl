	partition comparison_weights = m
		mode: import
		source =
				let
				    Parsed = Csv.Document(File.Contents(P003CsvFolder & "\comparison_weights.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Parsed, [PromoteAllScalars=true]),
				    Expected = {"source_sha256", "family", "method", "stratum", "included", "minimum_per_group", "a_sparse", "b_sparse", "a_yes", "a_n", "b_yes", "b_n", "a_rate", "b_rate", "weight_numerator", "weight_denominator", "weight"},
				    Checked = if Table.ColumnNames(Headers) = Expected then Headers else error "Unexpected P003 CSV headers",
				    Nullable = {"a_rate", "b_rate"},
				    Blanks = if List.IsEmpty(Nullable) then Checked else Table.ReplaceValue(Checked, "", null, Replacer.ReplaceValue, Nullable),
				    Typed = Table.TransformColumnTypes(Blanks, {{"source_sha256", type text}, {"family", type text}, {"method", type text}, {"stratum", type text}, {"included", type logical}, {"minimum_per_group", Int64.Type}, {"a_sparse", type logical}, {"b_sparse", type logical}, {"a_yes", Int64.Type}, {"a_n", Int64.Type}, {"b_yes", Int64.Type}, {"b_n", Int64.Type}, {"a_rate", type number}, {"b_rate", type number}, {"weight_numerator", Int64.Type}, {"weight_denominator", Int64.Type}, {"weight", type number}}, "en-US"),
				    Verified = if Table.RowCount(Typed) = 37 then Typed else error "Unexpected P003 CSV row count",
				    MonthOrder = [jan = 1, feb = 2, mar = 3, apr = 4, may = 5, jun = 6, jul = 7, aug = 8, sep = 9, oct = 10, nov = 11, dec = 12],
				    WithMonthOrder = Table.AddColumn(Verified, "calendar_month_order", each Record.FieldOrDefault(MonthOrder, [stratum], null), Int64.Type),
				    MonthLabels = [mar = "Mar", apr = "Apr", may = "May", jun = "Jun", jul = "Jul", aug = "Aug", sep = "Sep", oct = "Oct", nov = "Nov"],
				    WithMonthLabel = Table.AddColumn(WithMonthOrder, "calendar_month_label", each Record.FieldOrDefault(MonthLabels, [stratum], [stratum]), type text)
				in
				    WithMonthLabel

	annotation PBI_ResultType = Table
