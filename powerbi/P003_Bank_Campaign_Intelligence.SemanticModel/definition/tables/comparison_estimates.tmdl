	partition comparison_estimates = m
		mode: import
		source =
				let
				    Parsed = Csv.Document(File.Contents(P003CsvFolder & "\comparison_estimates.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Parsed, [PromoteAllScalars=true]),
				    Expected = {"source_sha256", "family", "method", "estimate_type", "a_yes", "a_n", "b_yes", "b_n", "a_rate", "b_rate", "included_strata", "gap_pp", "weighted_a_numerator", "weighted_b_numerator", "weighted_denominator"},
				    Checked = if Table.ColumnNames(Headers) = Expected then Headers else error "Unexpected P003 CSV headers",
				    Nullable = {"a_rate", "b_rate", "included_strata", "weighted_a_numerator", "weighted_b_numerator", "weighted_denominator"},
				    Blanks = if List.IsEmpty(Nullable) then Checked else Table.ReplaceValue(Checked, "", null, Replacer.ReplaceValue, Nullable),
				    Typed = Table.TransformColumnTypes(Blanks, {{"source_sha256", type text}, {"family", type text}, {"method", type text}, {"estimate_type", type text}, {"a_yes", Int64.Type}, {"a_n", Int64.Type}, {"b_yes", Int64.Type}, {"b_n", Int64.Type}, {"a_rate", type number}, {"b_rate", type number}, {"included_strata", Int64.Type}, {"gap_pp", type number}, {"weighted_a_numerator", type number}, {"weighted_b_numerator", type number}, {"weighted_denominator", Int64.Type}}, "en-US"),
				    Verified = if Table.RowCount(Typed) = 7 then Typed else error "Unexpected P003 CSV row count"
				in
				    Verified

	annotation PBI_ResultType = Table
