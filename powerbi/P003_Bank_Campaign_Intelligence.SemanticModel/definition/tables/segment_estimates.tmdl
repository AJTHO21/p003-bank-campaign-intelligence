	partition segment_estimates = m
		mode: import
		source =
				let
				    Parsed = Csv.Document(File.Contents(P003CsvFolder & "\segment_estimates.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Parsed, [PromoteAllScalars=true]),
				    Expected = {"source_sha256", "dimension", "level", "numerator", "denominator", "adjusted_rate", "gap_pp", "sparse_strata", "weighted_numerator", "weighted_denominator"},
				    Checked = if Table.ColumnNames(Headers) = Expected then Headers else error "Unexpected P003 CSV headers",
				    Nullable = {"adjusted_rate", "gap_pp", "weighted_numerator", "weighted_denominator"},
				    Blanks = if List.IsEmpty(Nullable) then Checked else Table.ReplaceValue(Checked, "", null, Replacer.ReplaceValue, Nullable),
				    Typed = Table.TransformColumnTypes(Blanks, {{"source_sha256", type text}, {"dimension", type text}, {"level", type text}, {"numerator", Int64.Type}, {"denominator", Int64.Type}, {"adjusted_rate", type number}, {"gap_pp", type number}, {"sparse_strata", Int64.Type}, {"weighted_numerator", type number}, {"weighted_denominator", Int64.Type}}, "en-US"),
				    Verified = if Table.RowCount(Typed) = 31 then Typed else error "Unexpected P003 CSV row count"
				in
				    Verified

	annotation PBI_ResultType = Table
